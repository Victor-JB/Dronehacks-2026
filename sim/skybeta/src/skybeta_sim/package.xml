<?xml version="1.0"?>
<package format="3">
  <name>skybeta_sim</name>
  <version>0.1.0</version>
  <description>Gazebo stand-ins for the parts of the skybeta drone the sim cannot run: the OAK-D driver,
    cuVSLAM and the safety pilot. Everything else is the drone's own code.</description>
  <maintainer email="noreply@example.com">dronehacks</maintainer>
  <license>MIT</license>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <exec_depend>ros_gz_bridge</exec_depend>
  <exec_depend>isaac_ros_visual_slam_interfaces</exec_depend>
  <exec_depend>oakd_vslam_bringup</exec_depend>
  <export><build_type>ament_python</build_type></export>
</package>
