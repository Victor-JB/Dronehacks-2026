<?xml version="1.0"?>
<package format="3">
  <name>dronehacks_nav</name>
  <version>0.1.0</version>
  <description>
    The team's refnav mission (refnav/core.py, refnav/depth.py) on the skybeta
    drone. Talks only to /skybeta/setpoint/pose, /skybeta/state,
    /visual_slam/* and read-only /fmu/out/*; skybeta_flight_interface owns
    /fmu/in/*, the safety envelope and the Offboard handover.
  </description>
  <maintainer email="victorjb2015@gmail.com">Victor Joulin-Batejat</maintainer>
  <license>Apache-2.0</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <exec_depend>px4_msgs</exec_depend>
  <exec_depend>isaac_ros_visual_slam_interfaces</exec_depend>
  <exec_depend>skybeta_flight_interface</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-opencv</exec_depend>

  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
