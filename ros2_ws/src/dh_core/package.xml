<?xml version="1.0"?>
<package format="3">
  <name>dh_core</name>
  <version>0.1.0</version>
  <description>DroneHacks core library: course model from mesh, clearance A*, time-optimal profiling, distance-field re-localisation, simulator (numpy only).</description>
  <maintainer email="team@example.com">DroneHacks team</maintainer>
  <license>MIT</license>
  <buildtool_depend>ament_python</buildtool_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-opencv</exec_depend>
  <!-- python3-scipy is optional (faster distance transform); not declared so nothing is installed for it -->
  <test_depend>python3-pytest</test_depend>
  <export><build_type>ament_python</build_type></export>
</package>
