<?xml version="1.0"?>
<package format="3">
  <name>dh_autonomy</name>
  <version>0.1.0</version>
  <description>DroneHacks ROS 2 Humble nodes: mission state machine, stereo pseudo-scan, map re-localiser, floor-line detector.</description>
  <maintainer email="team@example.com">DroneHacks team</maintainer>
  <license>MIT</license>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>dh_core</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>std_srvs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>message_filters</exec_depend>
  <exec_depend>python3-opencv</exec_depend>
  <!-- px4_msgs is optional: only needed for backend:=px4 (SITL or if organizers allow) -->
  <export><build_type>ament_python</build_type></export>
</package>
