<?xml version="1.0"?>
<package format="3">
  <name>dh_autonomy</name>
  <version>0.1.0</version>
  <description>DroneHacks ROS 2 Humble nodes: mission state machine, stereo pseudo-scan, map re-localiser, floor-line detector.</description>
  <maintainer email="team@example.com">DroneHacks team</maintainer>
  <license>MIT</license>
  <buildtool_depend>ament_python</buildtool_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>dh_core</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>std_srvs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>message_filters</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <exec_depend>builtin_interfaces</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>python3-opencv</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <!-- Optional, deliberately NOT declared (so rosdep never tries to install them on the drone):
       px4_msgs                          only for backend:=px4 (SITL); use the image's copy, never the team workspace
       isaac_ros_visual_slam_interfaces  VO tracking status (/visual_slam/status); imported if present -->
  <test_depend>python3-pytest</test_depend>
  <test_depend>launch_testing</test_depend>
  <test_depend>launch_testing_ros</test_depend>
  <export><build_type>ament_python</build_type></export>
</package>
